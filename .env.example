# Copy to .env and fill in. Never commit the real .env file (it is in .gitignore).

# ---- App ----
APP_ENV=development
CORS_ORIGINS=*
# Only needed if the default host ports are taken on your machine:
# FRONTEND_PORT=8081
# BACKEND_PORT=8001

# ---- Auth ----
# Generate: openssl rand -hex 32   (PowerShell: see README)
JWT_SECRET_KEY=change-me-to-a-random-64-char-hex-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ---- Pinecone (required in every mode) ----
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX_NAME=rag-knowledge-base
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# ---- Providers: pick ONE mode ----
# Mode A (default): AWS Bedrock for embeddings + LLM
EMBEDDING_PROVIDER=bedrock
LLM_PROVIDER=bedrock
BEDROCK_REGION=us-east-1
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_LLM_MODEL_ID=amazon.nova-pro-v1:0
EMBEDDING_DIMENSION=1024
# Real AWS keys used ONLY for Bedrock (docker compose fakes the other AWS keys via LocalStack)
BEDROCK_ACCESS_KEY_ID=
BEDROCK_SECRET_ACCESS_KEY=

# Mode B (no AWS Bedrock needed): Pinecone-hosted embeddings + any OpenAI-compatible LLM (Groq shown).
# Never mix embedding providers in one Pinecone index: use a different PINECONE_INDEX_NAME per mode.
# EMBEDDING_PROVIDER=pinecone
# PINECONE_EMBEDDING_MODEL=multilingual-e5-large
# PINECONE_INDEX_NAME=rag-pinecone-embed
# LLM_PROVIDER=openai_compatible
# LLM_API_KEY=your-provider-key
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b

# ---- AWS (real AWS only; docker compose overrides these with LocalStack fakes) ----
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL=
S3_BUCKET_NAME=rag-documents-bucket
DYNAMODB_TABLE_NAME=rag-documents-metadata
USERS_TABLE_NAME=rag-users
CONVERSATIONS_TABLE_NAME=rag-conversations
USE_SECRETS_MANAGER=false
SECRETS_MANAGER_SECRET_NAME=rag-app/prod/secrets

# ---- Redis / limits / retrieval ----
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_PER_MINUTE=20
CACHE_TTL_SECONDS=3600
CONVERSATION_HISTORY_TURNS=6
HYBRID_ALPHA=0.5
RETRIEVAL_CANDIDATE_MULTIPLIER=3
TOP_K_RESULTS=5
